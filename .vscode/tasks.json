{
  // Terminal → Aufgabe ausführen …
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lumenkorn: Release bauen",
      "detail": "Windows-Installer bauen, für den Updater signieren und latest.json erzeugen (tools/release_local.mjs)",
      "type": "shell",
      "command": "npm ci; node tools/release_local.mjs '${input:updaterKey}'",
      "windows": {
        "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Lumenkorn: Entwicklungsversion starten",
      "detail": "App mit Live-Neuladen starten (npm run tauri dev)",
      "type": "shell",
      "command": "npm run tauri dev",
      "problemMatcher": [],
      "isBackground": true
    }
  ],
  "inputs": [
    {
      "id": "updaterKey",
      "type": "promptString",
      "description": "Pfad zu lumenkorn-updater.key (leer lassen: Benutzerordner oder Downloads)",
      "default": ""
    }
  ]
}
